includes:
    - extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: max
    tmpDir: .cache/phpstan
    paths:
        - src
        - tests
    excludePaths:
        - tests/PHPStan/data
        - tests/PHPStan/Smoke
    ignoreErrors:
        -
            identifier: structuraQueryBuilder.flatConfiguration
            path: tests/Fixtures/Queries/ConfigurableQuery.php
